# Reference papers — copyright; cite in README instead
Paper/

# External repos — cloned locally, not submodules; see README for clone instructions
fm4ar/
sbi-ear/

# Data — never commit, download via scripts/download_mast.py and scripts/download_abc.py
# (includes real JWST data e.g. data/jwst_wasp39b_oot/ — >100MB files, D11 → Zenodo)
data/

# Model checkpoints and training outputs
checkpoints/
outputs/
runs/

# Weights & Biases
wandb/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
dist/
build/
*.so

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Environment
.env
*.env

# macOS
.DS_Store

# Large file formats (FITS, HDF5) — should live in data/ anyway
*.fits
*.fit
*.h5
*.hdf5

# Raw data drops (OOT frames, transmission spectra, opacities) shared as zips —
# large, not source; extracted into gitignored data/ subfolders
*.zip

# Model checkpoints + training snapshots — large + regenerable; release via Zenodo
configs/**/model__*.pt
configs/**/snapshots/
configs/cyclegan/cyclegan_epoch_*.pt

# Figures generated by scripts — regenerable, not source
figures/*.png
figures/*.pdf
# ...except the figures embedded in the README (must be tracked to render on GitHub)
!figures/fig6_multitarget.png
!figures/fig3_spectrum_fit.png

# WASP-96b reduction artifacts (P5-D3): large FITS + raw data + local configs
pipeline_outputs_directory_*/
configs_reduce/
wasp96b_dms.yaml
wasp96b_stage3.yaml
scratchpad_*.log

# Zenodo data bundle (staging + archive; .zenodo.json IS tracked)
zenodo_deposit/
mirage_zenodo_data_v1.tar.gz
